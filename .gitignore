# Model weights: ~313 GB. Fetched by `python -m llmperf.fetch`, never committed.
models/

# Virtual environment
.venv/
__pycache__/
*.pyc

# Local caches and transient state
results/gguf_meta_cache.json
results/campaign.lock.json
results/*.bak
results/*.part

# Raw stdout captures from analysis stages; regenerated on every run.
results/_analyze.out
results/_refine.out

# OS noise
.DS_Store

# Parallel Codex working copy (~954 MB, 31k files). A separate checkout of this
# same project, not part of it.
.workspaces/

# Local agent state
.claude/

# Supplied ICASSP author kit: keep only the source files needed to reproduce
# the paper; omit legacy Word/PostScript examples and duplicate guide PDFs.
.submission_reqiurement/*
!.submission_reqiurement/IEEEbib.bst
!.submission_reqiurement/spconf.sty

# ICASSP LaTeX intermediates (the final PDF is committed separately)
paper/icassp2027/build/
paper/icassp2027/supplement-build/
paper/icassp2027/*.aux
paper/icassp2027/*.bbl
paper/icassp2027/*.blg
paper/icassp2027/*.log
paper/icassp2027/*.out
